# Monitor Machine - Docker & Git Ignore

# Docker volumes and data (keep local, don't commit)
certs/*
!certs/.gitkeep
esdata01/
kibanadata/
fleetserverdata/
grafanadata/

# Local CA certificates (security)
ca.crt
*.pem
*.key

# Environment-specific files (keep secrets out of repo)
.env.local
.env.*.local

# Log files
*.log
docker-compose.override.yml

# OS files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
tmp/
temp/
*.tmp
