# ==================== ENVIRONMENT VARIABLES FOR APP-VM ====================
# Update these values for your setup

# ==================== CRITICAL: MONITOR MACHINE CONNECTION ====================
# Get these values from your monitor machine's .env file

# IP address of the monitor machine (where Elasticsearch, Kibana, Fleet Server run)
MONITOR_VM_IP=10.10.10.10

# Elasticsearch credentials from monitor machine
ELASTIC_PASSWORD=changeme
KIBANA_PASSWORD=changeme

# Elastic Stack version (must match monitor machine)
STACK_VERSION=9.3.1

# ==================== CRITICAL: FLEET ENROLLMENT TOKEN ====================
# Get this from: Monitor Machine Kibana → Fleet → Enrollment tokens
# Copy the token and paste it here
FLEET_ENROLLMENT_TOKEN=your_enrollment_token_here

# ==================== OPTIONAL: SETTINGS ====================

# Docker Compose Project Name
COMPOSE_PROJECT_NAME=app-microservices

# APM Secret Token (if required by your Fleet policy)
ELASTIC_APM_SECRET_TOKEN=supersecrettoken

# Application settings
JWT_SECRET=myfancysecret
